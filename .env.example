# Invoice Manager Configuration

# Server port (optional, default: 3000)
PORT=3000

# Session secret (optional, auto-generated if not set)
# Set this to a fixed value if you want sessions to persist across container restarts
# SESSION_SECRET=your-random-string-here

# API key for the JSON API at /api/v1 (optional, API is disabled if not set)
# Generate one with: openssl rand -hex 32
# API_KEY=your-api-key-here

# Public base URL (optional). When set, API/MCP responses include a clickable web_url for each invoice
# PUBLIC_URL=https://invoice.example.com

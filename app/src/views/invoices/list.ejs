<%
  const currencySymbols = { 'KRW': '₩', 'USD': '$', 'EUR': '€', 'JPY': '¥', 'GBP': '£', 'CNY': '¥' };
  function formatInvoiceAmount(amount, currency) {
    const curr = currency || 'KRW';
    const symbol = currencySymbols[curr] || '₩';
    if (curr === 'KRW' || curr === 'JPY') {
      return symbol + new Intl.NumberFormat('ko-KR').format(Math.round(amount));
    }
    return symbol + new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount);
  }
  // Build a list URL keeping the current status / tag / search
  function listUrl(overrides) {
    const params = Object.assign({ status: statusFilter, tag: tagFilter, q: searchQuery }, overrides);
    const qs = Object.keys(params).filter(k => params[k]).map(k => k + '=' + encodeURIComponent(params[k])).join('&');
    return '/invoices' + (qs ? '?' + qs : '');
  }
  const isFiltered = !!(statusFilter || tagFilter);
  // Tag palette (keys match TAG_COLORS in routes/tags.js): [chip classes, dot class]
  const tagColors = {
    gray: ['bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200', 'bg-gray-500'],
    red: ['bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-200', 'bg-red-500'],
    orange: ['bg-orange-100 text-orange-700 dark:bg-orange-900 dark:text-orange-200', 'bg-orange-500'],
    amber: ['bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-200', 'bg-amber-500'],
    green: ['bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-200', 'bg-green-500'],
    teal: ['bg-teal-100 text-teal-700 dark:bg-teal-900 dark:text-teal-200', 'bg-teal-500'],
    blue: ['bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-200', 'bg-blue-500'],
    indigo: ['bg-indigo-100 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-200', 'bg-indigo-500'],
    purple: ['bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-200', 'bg-purple-500'],
    pink: ['bg-pink-100 text-pink-700 dark:bg-pink-900 dark:text-pink-200', 'bg-pink-500']
  };
  const tagsById = Object.fromEntries(tags.map(tag => [tag.id, tag]));
  function tagChips(inv) {
    return (inv.tag_ids || []).filter(id => tagsById[id]).map(id => {
      const tag = tagsById[id];
      return `<span class="px-1.5 py-0.5 text-xs rounded ${(tagColors[tag.color] || tagColors.gray)[0]}">${escapeHtml(tag.name)}</span>`;
    }).join('');
  }
  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function formatProjectName(name) {
    if (!name) return '-';
    return name.replace(/\\n/g, ' ').replace(/\n/g, ' ');
  }
%>
<div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t('invoice.list') %></h1>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
    <% if (useClientSide) { %>
    <!-- Client-side filtering (instant) -->
    <div class="relative w-full sm:w-64">
      <input type="text" id="invoiceSearch"
        placeholder="<%= t('invoice.search_placeholder') %>"
        class="pl-10 pr-8 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 w-full">
      <svg class="absolute left-3 top-2.5 h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <button type="button" id="clearSearch" class="hidden absolute right-2 top-2.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" title="<%= t('invoice.clear_search') %>">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <% } else { %>
    <!-- Server-side filtering (for large datasets) -->
    <form method="GET" action="/invoices" class="flex items-center gap-2 w-full sm:w-auto">
      <% if (tagFilter) { %><input type="hidden" name="tag" value="<%= tagFilter %>"><% } %>
      <% if (statusFilter) { %><input type="hidden" name="status" value="<%= statusFilter %>"><% } %>
      <div class="relative flex-1 sm:w-64">
        <input type="text" name="q" value="<%= searchQuery || '' %>"
          placeholder="<%= t('invoice.search_placeholder') %>"
          class="pl-10 pr-8 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 w-full">
        <svg class="absolute left-3 top-2.5 h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <% if (searchQuery) { %>
        <a href="<%= listUrl({ q: '' }) %>" class="absolute right-2 top-2.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" title="<%= t('invoice.clear_search') %>">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </a>
        <% } %>
      </div>
      <button type="submit" class="p-2 bg-gray-100 dark:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-md hover:bg-gray-200 dark:hover:bg-gray-500" title="<%= t('common.search') %>">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </button>
    </form>
    <% } %>
    <a href="/invoices/new" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm hover:bg-blue-700 text-center w-full sm:w-auto">
      <%= t('invoice.new') %>
    </a>
  </div>
</div>

<!-- Status + tag filter -->
<div class="mb-4 flex flex-wrap items-center gap-2">
  <% [['', t('common.all')], ['draft', t('invoice.status_draft')], ['confirmed', t('invoice.status_confirmed')], ['discarded', t('invoice.status_discarded')]].forEach(([key, label]) => {
    const active = statusFilter === key; %>
  <a href="<%= listUrl({ status: key, page: '' }) %>"
    class="px-3 py-1 text-sm rounded-full border transition-colors <%= active ? 'bg-blue-600 border-blue-600 text-white' : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700' %>">
    <%= label %> <span class="<%= active ? 'text-blue-100' : 'text-gray-400 dark:text-gray-500' %>"><%= statusCounts[key || 'all'] || 0 %></span>
  </a>
  <% }) %>
  <span class="hidden sm:inline-block w-px h-5 bg-gray-300 dark:bg-gray-600 mx-1"></span>
  <% tags.forEach(tag => {
    const active = tagFilter === tag.id; %>
  <a href="<%= listUrl({ tag: active ? '' : tag.id, page: '' }) %>"
    class="inline-flex items-center gap-1.5 px-3 py-1 text-sm rounded-full border transition-colors <%= active ? 'bg-gray-800 dark:bg-gray-200 border-gray-800 dark:border-gray-200 text-white dark:text-gray-900' : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700' %>">
    <span class="w-2 h-2 rounded-full <%= (tagColors[tag.color] || tagColors.gray)[1] %>"></span><%= tag.name %>
    <span class="<%= active ? 'text-gray-300 dark:text-gray-600' : 'text-gray-400 dark:text-gray-500' %>"><%= tag.invoice_count %></span>
  </a>
  <% }) %>
  <button type="button" id="openTagManager" class="inline-flex items-center gap-1 px-3 py-1 text-sm rounded-full border border-dashed border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5a2 2 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
    <%= t('tag.manage') %>
  </button>
</div>

<div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
  <!-- Mobile: Card Layout -->
  <div class="sm:hidden divide-y divide-gray-200 dark:divide-gray-700">
    <div id="noInvoicesRowMobile" class="<%= invoices.length > 0 || (!useClientSide && searchQuery) || isFiltered ? 'hidden' : '' %> px-4 py-4 text-center text-sm text-gray-500 dark:text-gray-400">
      <%= t('invoice.no_invoices') %>
    </div>
    <div id="noResultsRowMobile" class="<%= (searchQuery || isFiltered) && invoices.length === 0 ? '' : 'hidden' %> px-4 py-4 text-center text-sm text-gray-500 dark:text-gray-400">
      <%= t('invoice.no_search_results') %>
    </div>
    <% if (invoices.length > 0) { %>
    <% invoices.forEach(inv => { %>
    <div class="invoice-row-mobile px-4 py-3" data-project="<%= (inv.project_name || '').toLowerCase() %>" data-client="<%= (inv.client_name || '').toLowerCase() %>">
      <!-- Row 1: Project + Status -->
      <div class="flex justify-between items-start mb-2">
        <a href="/invoices/<%= inv.id %>" class="text-sm font-medium text-blue-600 dark:text-blue-400 truncate flex-1 mr-2"><%= formatProjectName(inv.project_name) %></a>
        <button type="button" data-edit-tags="<%= inv.id %>" data-tag-ids="<%= JSON.stringify(inv.tag_ids || []) %>" title="<%= t('tag.title') %>" class="p-0.5 mr-1 rounded text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5a2 2 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
        </button>
        <div class="status-dropdown inline-block relative">
          <button type="button" data-status-btn="<%= inv.id %>"
            class="status-btn px-2 py-0.5 text-xs rounded-full cursor-pointer transition-colors whitespace-nowrap
            <%= inv.status === 'draft' ? 'bg-gray-100 dark:bg-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-500' : inv.status === 'confirmed' ? 'bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 hover:bg-green-200 dark:hover:bg-green-800' : 'bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-800' %>"
            data-status="<%= inv.status %>">
            <%= inv.status === 'draft' ? t('invoice.status_draft') : inv.status === 'confirmed' ? t('invoice.status_confirmed') : t('invoice.status_discarded') %>
          </button>
          <div class="status-menu hidden absolute z-10 mt-1 right-0 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-600 py-1 min-w-[100px]">
            <button type="button" data-set-status="draft" data-invoice-id="<%= inv.id %>" class="block w-full px-3 py-1.5 text-xs text-left hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-300"><%= t('invoice.status_draft') %></button>
            <button type="button" data-set-status="confirmed" data-invoice-id="<%= inv.id %>" class="block w-full px-3 py-1.5 text-xs text-left hover:bg-gray-100 dark:hover:bg-gray-700 text-green-600 dark:text-green-400"><%= t('invoice.status_confirmed') %></button>
            <button type="button" data-set-status="discarded" data-invoice-id="<%= inv.id %>" class="block w-full px-3 py-1.5 text-xs text-left hover:bg-gray-100 dark:hover:bg-gray-700 text-red-600 dark:text-red-400"><%= t('invoice.status_discarded') %></button>
          </div>
        </div>
      </div>
      <!-- Tags (hidden while empty) -->
      <div class="tag-list flex flex-wrap items-center gap-1 mb-2 empty:hidden" data-invoice-id="<%= inv.id %>"><%- tagChips(inv) %></div>
      <!-- Row 2: Amount + Actions -->
      <div class="flex justify-between items-center">
        <span class="text-sm font-medium text-gray-900 dark:text-white"><%= formatInvoiceAmount(inv.total_amount, inv.currency) %></span>
        <div class="flex items-center gap-3 text-xs">
          <a href="/invoices/<%= inv.id %>" class="text-green-600 dark:text-green-400"><%= t('invoice.print') %></a>
          <a href="/invoices/<%= inv.id %>/edit" class="<%= inv.status === 'confirmed' || inv.status === 'discarded' ? 'text-gray-400 dark:text-gray-500 pointer-events-none' : 'text-blue-600 dark:text-blue-400' %>"><%= t('common.edit') %></a>
          <form method="POST" action="/invoices/<%= inv.id %>/duplicate" class="inline">
            <button type="submit" class="text-purple-600 dark:text-purple-400"><%= t('invoice.duplicate') %></button>
          </form>
          <form method="POST" action="/invoices/<%= inv.id %>/delete" onsubmit="return confirm('<%= t('common.confirm_delete') %>')" class="inline">
            <button type="submit" class="text-red-600 dark:text-red-400"><%= t('common.delete') %></button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
    <% } %>
  </div>

  <!-- Desktop: Table Layout -->
  <div class="hidden sm:block overflow-x-auto">
    <table class="min-w-full">
      <thead class="bg-gray-50 dark:bg-gray-700">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-200 hidden sm:table-cell"><%= t('invoice.number') %></th>
          <th class="px-4 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-200"><%= t('invoice.project') %></th>
          <th class="px-4 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-200 hidden lg:table-cell"><%= t('invoice.client') %></th>
          <th class="px-4 py-3 text-left text-sm font-bold text-gray-700 dark:text-gray-200 hidden xl:table-cell"><%= t('invoice.date') %></th>
          <th class="px-4 py-3 text-right text-sm font-bold text-gray-700 dark:text-gray-200"><%= t('invoice.amount') %></th>
          <th class="px-4 py-3 text-center text-sm font-bold text-gray-700 dark:text-gray-200"><%= t('invoice.status') %></th>
          <th class="px-4 py-3 text-right text-sm font-bold text-gray-700 dark:text-gray-200"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        <tr id="noInvoicesRow" class="<%= invoices.length > 0 || (!useClientSide && searchQuery) || isFiltered ? 'hidden' : '' %>">
          <td colspan="7" class="px-4 py-4 text-center text-sm text-gray-500 dark:text-gray-400">
            <%= t('invoice.no_invoices') %>
          </td>
        </tr>
        <tr id="noResultsRow" class="<%= (searchQuery || isFiltered) && invoices.length === 0 ? '' : 'hidden' %>">
          <td colspan="7" class="px-4 py-4 text-center text-sm text-gray-500 dark:text-gray-400">
            <%= t('invoice.no_search_results') %>
          </td>
        </tr>
        <% if (invoices.length > 0) { %>
        <% invoices.forEach(inv => { %>
        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 invoice-row" data-project="<%= (inv.project_name || '').toLowerCase() %>" data-client="<%= (inv.client_name || '').toLowerCase() %>">
          <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300 hidden sm:table-cell whitespace-nowrap"><%= inv.invoice_number %></td>
          <td class="px-4 py-4 text-sm">
            <!-- Long titles wrap on their own; tags and the tag button stay on the right -->
            <div class="flex items-center gap-1.5">
              <a href="/invoices/<%= inv.id %>" class="min-w-0 text-blue-600 dark:text-blue-400 hover:underline font-medium"><%= formatProjectName(inv.project_name) %></a>
              <span class="tag-list inline-flex shrink-0 gap-1 empty:hidden" data-invoice-id="<%= inv.id %>"><%- tagChips(inv) %></span>
              <button type="button" data-edit-tags="<%= inv.id %>" data-tag-ids="<%= JSON.stringify(inv.tag_ids || []) %>" title="<%= t('tag.title') %>" class="shrink-0 p-0.5 rounded text-gray-300 dark:text-gray-600 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5a2 2 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
              </button>
            </div>
          </td>
          <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300 hidden lg:table-cell"><%= inv.client_name || '-' %></td>
          <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300 hidden xl:table-cell whitespace-nowrap"><%= inv.issue_date || '-' %></td>
          <td class="px-4 py-4 text-sm text-right font-medium text-gray-900 dark:text-white whitespace-nowrap"><%= formatInvoiceAmount(inv.total_amount, inv.currency) %></td>
          <td class="px-4 py-4 text-center relative whitespace-nowrap">
            <div class="status-dropdown inline-block">
              <button type="button" data-status-btn="<%= inv.id %>"
                class="status-btn px-2 py-1 text-xs rounded-full cursor-pointer transition-colors
                <%= inv.status === 'draft' ? 'bg-gray-100 dark:bg-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-500' : inv.status === 'confirmed' ? 'bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 hover:bg-green-200 dark:hover:bg-green-800' : 'bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-800' %>"
                data-status="<%= inv.status %>">
                <%= inv.status === 'draft' ? t('invoice.status_draft') : inv.status === 'confirmed' ? t('invoice.status_confirmed') : t('invoice.status_discarded') %>
              </button>
              <div class="status-menu hidden absolute z-10 mt-1 left-1/2 -translate-x-1/2 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-600 py-1 min-w-[100px]">
                <button type="button" data-set-status="draft" data-invoice-id="<%= inv.id %>" class="block w-full px-3 py-1.5 text-xs text-left hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-300"><%= t('invoice.status_draft') %></button>
                <button type="button" data-set-status="confirmed" data-invoice-id="<%= inv.id %>" class="block w-full px-3 py-1.5 text-xs text-left hover:bg-gray-100 dark:hover:bg-gray-700 text-green-600 dark:text-green-400"><%= t('invoice.status_confirmed') %></button>
                <button type="button" data-set-status="discarded" data-invoice-id="<%= inv.id %>" class="block w-full px-3 py-1.5 text-xs text-left hover:bg-gray-100 dark:hover:bg-gray-700 text-red-600 dark:text-red-400"><%= t('invoice.status_discarded') %></button>
              </div>
            </div>
          </td>
          <td class="px-4 py-4 text-right whitespace-nowrap">
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 w-fit justify-end ml-auto">
              <a href="/invoices/<%= inv.id %>" class="text-green-600 dark:text-green-400 hover:underline text-sm"><%= t('invoice.print') %></a>
              <a href="/invoices/<%= inv.id %>/edit" class="edit-link text-sm <%= inv.status === 'confirmed' || inv.status === 'discarded' ? 'text-gray-400 dark:text-gray-500 cursor-not-allowed pointer-events-none' : 'text-blue-600 dark:text-blue-400 hover:underline' %>"><%= t('common.edit') %></a>
              <form method="POST" action="/invoices/<%= inv.id %>/duplicate">
                <button type="submit" class="text-purple-600 dark:text-purple-400 hover:underline text-sm"><%= t('invoice.duplicate') %></button>
              </form>
              <form method="POST" action="/invoices/<%= inv.id %>/delete" onsubmit="return confirm('<%= t('common.confirm_delete') %>')">
                <button type="submit" class="text-red-600 dark:text-red-400 hover:underline text-sm"><%= t('common.delete') %></button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (!useClientSide && totalPages > 1) { %>
  <div class="px-4 py-3 bg-gray-50 dark:bg-gray-700 border-t border-gray-200 dark:border-gray-600 flex flex-col sm:flex-row justify-between items-center gap-2">
    <span class="text-sm text-gray-600 dark:text-gray-300">
      <%= t('invoice.page_info').replace('{{current}}', currentPage).replace('{{total}}', totalPages) %>
    </span>
    <div class="flex gap-2">
      <% if (currentPage > 1) { %>
      <a href="<%= listUrl({ page: currentPage - 1 }) %>"
        class="px-3 py-1 text-sm border border-gray-300 dark:border-gray-600 rounded-md text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600">
        <%= t('invoice.prev_page') %>
      </a>
      <% } else { %>
      <span class="px-3 py-1 text-sm border border-gray-200 dark:border-gray-700 rounded-md text-gray-400 dark:text-gray-500 cursor-not-allowed">
        <%= t('invoice.prev_page') %>
      </span>
      <% } %>
      <% if (currentPage < totalPages) { %>
      <a href="<%= listUrl({ page: currentPage + 1 }) %>"
        class="px-3 py-1 text-sm border border-gray-300 dark:border-gray-600 rounded-md text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600">
        <%= t('invoice.next_page') %>
      </a>
      <% } else { %>
      <span class="px-3 py-1 text-sm border border-gray-200 dark:border-gray-700 rounded-md text-gray-400 dark:text-gray-500 cursor-not-allowed">
        <%= t('invoice.next_page') %>
      </span>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<% if (useClientSide) { %>
<script>
(function() {
  const searchInput = document.getElementById('invoiceSearch');
  const clearBtn = document.getElementById('clearSearch');
  const rows = document.querySelectorAll('.invoice-row');
  const noInvoicesRow = document.getElementById('noInvoicesRow');
  const noResultsRow = document.getElementById('noResultsRow');

  function filterInvoices() {
    const query = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    clearBtn.classList.toggle('hidden', !query);

    rows.forEach(row => {
      const project = row.dataset.project || '';
      const client = row.dataset.client || '';
      const match = !query || project.includes(query) || client.includes(query);
      row.classList.toggle('hidden', !match);
      if (match) visibleCount++;
    });

    noInvoicesRow.classList.add('hidden');
    noResultsRow.classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
    if (rows.length === 0 && !query && !<%- JSON.stringify(isFiltered) %>) {
      noInvoicesRow.classList.remove('hidden');
    }
  }

  searchInput.addEventListener('input', filterInvoices);
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    filterInvoices();
    searchInput.focus();
  });
})();
</script>
<% } %>

<script>
(function() {
  var statusLabels = {
    draft: '<%- t("invoice.status_draft") %>',
    confirmed: '<%- t("invoice.status_confirmed") %>',
    discarded: '<%- t("invoice.status_discarded") %>'
  };

  var statusClasses = {
    draft: 'status-btn px-2 py-1 text-xs rounded-full cursor-pointer transition-colors bg-gray-100 dark:bg-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-500',
    confirmed: 'status-btn px-2 py-1 text-xs rounded-full cursor-pointer transition-colors bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 hover:bg-green-200 dark:hover:bg-green-800',
    discarded: 'status-btn px-2 py-1 text-xs rounded-full cursor-pointer transition-colors bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-800'
  };

  // Close all dropdowns
  function closeAllMenus() {
    document.querySelectorAll('.status-menu').forEach(function(menu) {
      menu.classList.add('hidden');
    });
  }

  // Toggle dropdown menu
  document.addEventListener('click', function(e) {
    var statusBtn = e.target.closest('[data-status-btn]');
    if (statusBtn) {
      e.stopPropagation();
      var menu = statusBtn.nextElementSibling;
      var isOpen = !menu.classList.contains('hidden');
      closeAllMenus();
      if (!isOpen) {
        menu.classList.remove('hidden');
      }
      return;
    }

    // Handle status selection
    var setStatusBtn = e.target.closest('[data-set-status]');
    if (setStatusBtn) {
      var newStatus = setStatusBtn.dataset.setStatus;
      var invoiceId = setStatusBtn.dataset.invoiceId;
      var dropdown = setStatusBtn.closest('.status-dropdown');
      var btn = dropdown.querySelector('[data-status-btn]');
      var row = dropdown.closest('tr');

      fetch('/invoices/' + invoiceId + '/set-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            btn.dataset.status = data.status;
            btn.textContent = statusLabels[data.status];
            btn.className = statusClasses[data.status];

            // Row no longer matches the active status filter
            if (<%- JSON.stringify(statusFilter) %> && data.status !== <%- JSON.stringify(statusFilter) %>) {
              location.reload();
              return;
            }

            // Update edit link visibility
            var editLink = row && row.querySelector('.edit-link');
            if (editLink) {
              if (data.status === 'confirmed' || data.status === 'discarded') {
                editLink.className = 'edit-link text-sm text-gray-400 dark:text-gray-500 cursor-not-allowed pointer-events-none';
              } else {
                editLink.className = 'edit-link text-sm text-blue-600 dark:text-blue-400 hover:underline';
              }
            }
          }
        })
        .catch(function(err) {
          console.error('Failed to set status:', err);
        });

      closeAllMenus();
      return;
    }

    // Close menus when clicking outside
    closeAllMenus();
  });
})();
</script>

<!-- Tag picker (shared popover for all rows) -->
<div id="tagPicker" class="hidden fixed z-20 w-56 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-600 py-1">
  <div id="tagPickerList" class="max-h-64 overflow-y-auto"></div>
  <p id="tagPickerEmpty" class="hidden px-3 py-2 text-xs text-gray-500 dark:text-gray-400"><%= t('tag.none') %></p>
  <button type="button" data-open-tag-manager class="block w-full px-3 py-1.5 text-xs text-left text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 border-t border-gray-100 dark:border-gray-700"><%= t('tag.manage') %>…</button>
</div>

<!-- Tag manager -->
<div id="tagManager" class="hidden fixed inset-0 z-30 bg-black/40 flex items-start sm:items-center justify-center p-4">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-md p-4">
    <div class="flex justify-between items-center mb-3">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white"><%= t('tag.manage') %></h2>
      <button type="button" data-close-tag-manager class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="tagManagerList" class="space-y-2 mb-4"></div>
    <form id="newTagForm" class="flex gap-2 pt-3 border-t border-gray-200 dark:border-gray-700">
      <input type="text" name="name" maxlength="30" required placeholder="<%= t('tag.new_placeholder') %>"
        class="flex-1 min-w-0 px-3 py-1.5 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
      <select name="color" class="tag-color-select px-2 py-1.5 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white"></select>
      <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700"><%= t('common.add') %></button>
    </form>
    <p id="tagManagerError" class="hidden mt-2 text-sm text-red-600 dark:text-red-400"></p>
  </div>
</div>

<script>
(function() {
  // Escape "<" so a tag name cannot close this script block
  var tags = <%- JSON.stringify(tags.map(tag => ({ id: tag.id, name: tag.name, color: tag.color, invoice_count: tag.invoice_count }))).replace(/</g, '\\u003c') %>;
  var tagColors = <%- JSON.stringify(tagColors) %>;
  var tagFilter = <%- JSON.stringify(tagFilter) %>;
  var labels = {
    colors: <%- JSON.stringify(Object.fromEntries(Object.keys(tagColors).map(c => [c, t('tag.color_' + c)]))) %>,
    save: <%- JSON.stringify(t('common.save')) %>,
    del: <%- JSON.stringify(t('common.delete')) %>,
    confirmDelete: <%- JSON.stringify(t('tag.confirm_delete')) %>,
    failed: <%- JSON.stringify(t('tag.error_failed')) %>
  };
  var tagsById = {};
  tags.forEach(function(tag) { tagsById[tag.id] = tag; });

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function colorOf(tag) { return tagColors[tag.color] || tagColors.gray; }

  function postJson(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body || {})
    }).then(function(res) {
      return res.json().then(function(data) {
        if (!res.ok) throw new Error(data.error || labels.failed);
        return data;
      });
    });
  }

  // ---- Per-invoice tag picker ----
  var picker = document.getElementById('tagPicker');
  var pickerList = document.getElementById('tagPickerList');
  var pickerInvoiceId = null;

  function renderInvoiceTags(invoiceId, tagIds) {
    var html = tagIds.filter(function(id) { return tagsById[id]; }).map(function(id) {
      var tag = tagsById[id];
      return '<span class="px-1.5 py-0.5 text-xs rounded ' + colorOf(tag)[0] + '">' + escapeHtml(tag.name) + '</span>';
    }).join('');
    document.querySelectorAll('.tag-list[data-invoice-id="' + invoiceId + '"]').forEach(function(el) { el.innerHTML = html; });
    document.querySelectorAll('[data-edit-tags="' + invoiceId + '"]').forEach(function(el) { el.dataset.tagIds = JSON.stringify(tagIds); });
  }

  function openPicker(btn) {
    pickerInvoiceId = btn.dataset.editTags;
    var selected = JSON.parse(btn.dataset.tagIds || '[]');
    pickerList.innerHTML = tags.map(function(tag) {
      return '<label class="flex items-center gap-2 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer">' +
        '<input type="checkbox" value="' + tag.id + '"' + (selected.indexOf(tag.id) >= 0 ? ' checked' : '') + ' class="rounded">' +
        '<span class="w-2 h-2 rounded-full ' + colorOf(tag)[1] + '"></span>' + escapeHtml(tag.name) + '</label>';
    }).join('');
    document.getElementById('tagPickerEmpty').classList.toggle('hidden', tags.length > 0);

    var rect = btn.getBoundingClientRect();
    picker.classList.remove('hidden');
    picker.style.left = Math.max(8, Math.min(rect.left, window.innerWidth - picker.offsetWidth - 8)) + 'px';
    var top = rect.bottom + 4;
    if (top + picker.offsetHeight > window.innerHeight - 8) top = Math.max(8, rect.top - picker.offsetHeight - 4);
    picker.style.top = top + 'px';
  }

  function closePicker() {
    picker.classList.add('hidden');
    pickerInvoiceId = null;
  }

  pickerList.addEventListener('change', function() {
    var invoiceId = pickerInvoiceId;
    var tagIds = Array.prototype.map.call(pickerList.querySelectorAll('input:checked'), function(input) { return parseInt(input.value); });
    postJson('/invoices/' + invoiceId + '/tags', { tag_ids: tagIds })
      .then(function(data) {
        // Row no longer matches the active tag filter
        if (tagFilter && data.tag_ids.indexOf(tagFilter) < 0) {
          location.reload();
          return;
        }
        renderInvoiceTags(invoiceId, data.tag_ids);
      })
      .catch(function(err) { alert(err.message); });
  });

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-edit-tags]');
    if (btn) {
      e.stopPropagation();
      if (pickerInvoiceId === btn.dataset.editTags) closePicker();
      else openPicker(btn);
      return;
    }
    if (!e.target.closest('#tagPicker')) closePicker();
  });
  window.addEventListener('scroll', closePicker, true);

  // ---- Tag manager ----
  var manager = document.getElementById('tagManager');
  var managerList = document.getElementById('tagManagerList');
  var managerError = document.getElementById('tagManagerError');
  var changed = false;

  function colorOptions(selected) {
    return Object.keys(tagColors).map(function(color) {
      return '<option value="' + color + '"' + (color === selected ? ' selected' : '') + '>' + escapeHtml(labels.colors[color]) + '</option>';
    }).join('');
  }

  function showError(message) {
    managerError.textContent = message;
    managerError.classList.toggle('hidden', !message);
  }

  function renderManager() {
    managerList.innerHTML = tags.map(function(tag) {
      return '<form class="tag-row flex items-center gap-2" data-tag-id="' + tag.id + '">' +
        '<span class="tag-dot w-2.5 h-2.5 shrink-0 rounded-full ' + colorOf(tag)[1] + '"></span>' +
        '<input type="text" name="name" maxlength="30" required value="' + escapeHtml(tag.name) + '" class="flex-1 min-w-0 px-2 py-1 border border-gray-300 dark:border-gray-600 rounded text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white">' +
        '<select name="color" class="tag-color-select px-1 py-1 border border-gray-300 dark:border-gray-600 rounded text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white">' + colorOptions(tag.color) + '</select>' +
        '<span class="w-6 text-right text-xs text-gray-400">' + tag.invoice_count + '</span>' +
        '<button type="submit" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">' + escapeHtml(labels.save) + '</button>' +
        '<button type="button" data-delete-tag class="text-sm text-red-600 dark:text-red-400 hover:underline">' + escapeHtml(labels.del) + '</button>' +
        '</form>';
    }).join('');
  }

  function openManager() {
    closePicker();
    renderManager();
    document.querySelector('#newTagForm .tag-color-select').innerHTML = colorOptions('gray');
    showError('');
    manager.classList.remove('hidden');
    document.querySelector('#newTagForm input[name="name"]').focus();
  }

  function closeManager() {
    manager.classList.add('hidden');
    if (changed) location.reload();
  }

  document.getElementById('openTagManager').addEventListener('click', openManager);
  document.querySelector('[data-open-tag-manager]').addEventListener('click', openManager);
  document.querySelector('[data-close-tag-manager]').addEventListener('click', closeManager);
  manager.addEventListener('click', function(e) { if (e.target === manager) closeManager(); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !manager.classList.contains('hidden')) closeManager();
  });

  document.getElementById('newTagForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var form = e.target;
    postJson('/tags', { name: form.name.value, color: form.color.value })
      .then(function(data) {
        var tag = Object.assign({ invoice_count: 0 }, data.tag);
        tags.push(tag);
        tagsById[tag.id] = tag;
        changed = true;
        form.name.value = '';
        showError('');
        renderManager();
      })
      .catch(function(err) { showError(err.message); });
  });

  // Live color preview
  managerList.addEventListener('change', function(e) {
    if (!e.target.matches('.tag-color-select')) return;
    var dot = e.target.closest('.tag-row').querySelector('.tag-dot');
    dot.className = 'tag-dot w-2.5 h-2.5 shrink-0 rounded-full ' + (tagColors[e.target.value] || tagColors.gray)[1];
  });

  managerList.addEventListener('submit', function(e) {
    e.preventDefault();
    var form = e.target;
    var tag = tagsById[form.dataset.tagId];
    postJson('/tags/' + tag.id, { name: form.name.value, color: form.color.value })
      .then(function() {
        tag.name = form.name.value.trim();
        tag.color = form.color.value;
        changed = true;
        showError('');
        renderManager();
      })
      .catch(function(err) { showError(err.message); });
  });

  managerList.addEventListener('click', function(e) {
    if (!e.target.matches('[data-delete-tag]')) return;
    var tag = tagsById[e.target.closest('.tag-row').dataset.tagId];
    if (!confirm(labels.confirmDelete.replace('{{name}}', tag.name))) return;
    postJson('/tags/' + tag.id + '/delete')
      .then(function() {
        tags = tags.filter(function(t) { return t.id !== tag.id; });
        delete tagsById[tag.id];
        changed = true;
        showError('');
        renderManager();
      })
      .catch(function(err) { showError(err.message); });
  });
})();
</script>
